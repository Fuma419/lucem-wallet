{
  "extends": "react-app",
  "globals": {
    "chrome": "readonly"
  },
  "env": {
    "es2020": true,
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.spec.js",
        "src/test/**/*.js",
        "jest.setup.js"
      ],
      "env": { "jest": true },
      // jest.mock() has to be hoisted above the imports it replaces, and
      // require() after import is the usual way to load a mocked module, so
      // import/first fights the mocking pattern rather than catching bugs.
      "rules": { "import/first": "off" }
    }
  ],
  "parserOptions": {
    "babelOptions": {
      "presets": [
        ["babel-preset-react-app", false],
        "babel-preset-react-app/prod"
      ]
    }
  }
}
