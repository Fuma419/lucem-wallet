<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Wallet state lives in the WebView (IndexedDB). Do not copy it in
         cloud backup or device-to-device transfer. -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
