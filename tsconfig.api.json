{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "jsx": "react",
    "isolatedModules": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/api/**/*.ts",
    "src/api/**/*.js"
  ],
  "exclude": [
    "src/ui",
    "node_modules"
  ]
}
